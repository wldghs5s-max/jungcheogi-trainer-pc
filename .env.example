# Backend Server Port
PORT=8765
HOST=127.0.0.1
NODE_ENV=development

# Database path (relative to server cwd or absolute)
DATABASE_PATH=data/jungcheogi.db

# Frontend CORS origin
CORS_ORIGIN=http://localhost:5173

# Optional local API token. Empty = loopback only, no extra header.
LOCAL_API_TOKEN=

# Gemini API Key (Phase 5+)
GEMINI_API_KEY=
