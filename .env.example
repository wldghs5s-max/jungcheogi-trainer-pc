# Backend Server Port
PORT=8765
# LAN/터널용은 0.0.0.0. Cloudflare Quick Tunnel은 보통 localhost로 붙는다.
HOST=0.0.0.0
NODE_ENV=development

# Database path (relative to server cwd or absolute)
DATABASE_PATH=data/jungcheogi.db

# Frontend CORS origin
CORS_ORIGIN=http://localhost:5173

# 집 밖 터널/LAN 사용 시 설정 권장. 비어 있으면 추가 헤더 없이 통과.
LOCAL_API_TOKEN=

# Gemini API Key (Phase 5+)
GEMINI_API_KEY=
