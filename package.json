{
  "name": "jungcheogi-trainer-pc",
  "version": "0.1.0",
  "private": true,
  "description": "정처기 실기 PC 집중학습 플랫폼",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"cyan.bold,green.bold\" \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w shared && npm run build -w server && npm run build -w client",
    "test": "npm run test -w server",
    "test:server": "npm run test -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "playwright": "^1.63.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true
  }
}
